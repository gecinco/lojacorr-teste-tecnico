{
    "name": "lojacorr/seguros-api",
    "description": "API de Contratação de Seguros - Desafio Técnico Lojacorr",
    "keywords": ["seguros", "laravel", "api", "lojacorr"],
    "license": "MIT",
    "type": "project",
    "require": {
        "php": "^7.3",
        "laravel/framework": "5.8.*",
        "tymon/jwt-auth": "^1.0",
        "jenssegers/mongodb": "3.5.0",
        "mongodb/mongodb": "^1.0.0 <1.14.0",
        "predis/predis": "^1.1",
        "guzzlehttp/guzzle": "^6.5",
        "fideloper/proxy": "^4.0",
        "fruitcake/laravel-cors": "^1.0"
    },
    "require-dev": {
        "mockery/mockery": "^1.0",
        "phpunit/phpunit": "^7.5"
    },
    "autoload": {
        "classmap": [
            "database/seeds"
        ],
        "psr-4": {
            "App\\": "app/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "scripts": {
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "test": "vendor/bin/phpunit"
    },
    "config": {
        "preferred-install": "dist",
        "sort-packages": true,
        "optimize-autoloader": true,
        "platform": {
            "php": "7.3.33"
        }
    },
    "prefer-stable": true
}
