# ===========================================
# LOJACORR SEGUROS - CONFIGURAÇÃO DE AMBIENTE
# ===========================================
# Copie este arquivo para .env e configure conforme necessário

# ===========================================
# BACKEND (Laravel)
# ===========================================
APP_NAME="Lojacorr Seguros"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

# Banco de Dados (MariaDB)
DB_CONNECTION=mysql
DB_HOST=mariadb
DB_PORT=3306
DB_DATABASE=lojacorr_seguros
DB_USERNAME=lojacorr
DB_PASSWORD=lojacorr123

# Cache (Redis)
CACHE_DRIVER=redis
SESSION_DRIVER=redis
QUEUE_CONNECTION=redis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

# MongoDB (Logs de Auditoria)
MONGO_HOST=mongodb
MONGO_PORT=27017
MONGO_DATABASE=lojacorr_logs
MONGO_USERNAME=admin
MONGO_PASSWORD=admin123

# JWT (Autenticação)
JWT_SECRET=
JWT_TTL=60
JWT_REFRESH_TTL=20160

# ===========================================
# FRONTEND (Nuxt 3)
# ===========================================
NUXT_PUBLIC_API_BASE=http://localhost:8000/api/v1

# ===========================================
# APIs EXTERNAS
# ===========================================
VIACEP_TIMEOUT=5000
VIACEP_BASE_URL=https://viacep.com.br/ws

# ===========================================
# RATE LIMITING
# ===========================================
RATE_LIMIT_PER_MINUTE=60

# ===========================================
# DOCKER (apenas para desenvolvimento)
# ===========================================
COMPOSE_PROJECT_NAME=lojacorr-seguros
